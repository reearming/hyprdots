@import "colors.rasi"

configuration {
    modi: "drun,run,window";
    show-icons: true;
    font: "JetBrainsMono NF 12";
//    icon-theme: "Papirus";
}

window {
    background-color: @surface;
    padding: 10px;
    border: 2px;
    border-color: @primary;
    border-radius: 10px;
}

mainbox {
    background-color: transparent; 
}

prompt {
    background-color: transparent;
    text-color: @on-surface;
}

entry {
    background-color: transparent;
    text-color: @on-surface;
}

listview {
    spacing: 8px;
}

scrollbar {
    background-color: @on-secondary;
    handle-color: @secondary;
}

element-icon {
    size: 30px;
    padding: 3px;
}

element normal.normal, element normal.urgent, element normal.active {
    background-color: transparent;
}

element alternate.normal, element alternate.urgent, element alternate.active {
    background-color: transparent;
}

element-text normal.normal, element-text alternate.normal {
    background-color: transparent;
    text-color: @on-surface;
}

element selected.normal, element selected.urgent, element selected.active {
    background-color: @primary;
    --border: 5px;
    border-color: @primary;
    border-radius: 5px;
}

element-text selected.normal, element-text selected.urgent, element-text selected.active {
    background-color: transparent;
    text-color: @on-primary;
}

