{
    "layer": "top",
    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["hyprland/window"],
    "modules-right": ["tray", "clock"],
    "hyprland/window": {
        "max-length": 50
    },

    "clock": {
        "format-alt": "{:%a, %d. %b  %H:%M}"
    },

    "tray": {
    "icon-size": 20,
    "spacing": 10
    }
}

